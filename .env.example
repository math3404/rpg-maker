# Segredos Django
DJANGO_SECRET_KEY=your-django-secret-key-placeholder
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco do Django. Vazio = SQLite local.
# Em produção, use a URL PostgreSQL de conexão Session Pooler do Supabase.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.example.supabase.co:5432/postgres

# Supabase Data API (somente backend Django; NUNCA coloque a chave no HTML/JS)
# Crie uma cópia deste arquivo chamada .env na mesma pasta do manage.py.
# Use a Secret key que começa com sb_secret_, NÃO a Publishable key sb_publishable_.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SUPABASE_SECRET_KEY

# E-mail SMTP para redefinição de senha em produção (opcional em desenvolvimento)
# Em produção, troque para django.core.mail.backends.smtp.EmailBackend e preencha os dados abaixo.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.seuprovedor.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=seu-email
# EMAIL_HOST_PASSWORD=sua-senha-de-aplicativo
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL="RPG Maker <nao-responder@seudominio.com>"
